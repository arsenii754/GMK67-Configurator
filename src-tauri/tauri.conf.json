{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GMK67 Configurator",
  "version": "1.0.0",
  "identifier": "lol.ttfdk.gmk67.configurator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZUOYA GMK67 Configurator",
        "width": 1240,
        "height": 920,
        "minWidth": 960,
        "minHeight": 760,
        "resizable": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

